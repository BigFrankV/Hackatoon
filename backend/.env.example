# Application
APP_NAME=Licitaciones AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# Security (replace in real environments)
SECRET_KEY=change-me-in-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# Login protection
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Database
DATABASE_URL=postgresql+asyncpg://licitaciones:licitaciones_dev_password@localhost:5432/licitaciones
DATABASE_ECHO=false

# Local AI and private document processing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
AI_PROVIDER_TIMEOUT_SECONDS=180
PRIVATE_STORAGE_ROOT=storage/private
MAX_DOCUMENT_UPLOAD_BYTES=26214400
RAG_MIN_SIMILARITY=0.35

# Mercado Público API ticket (keep the real value private)
PROCUREMENT_API_TICKET=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
